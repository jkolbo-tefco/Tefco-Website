---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqPage, breadcrumb } from '../lib/schema';

const path = '/faqs/';
const title = 'FAQs — Custom Iron, Powder Coating & Fabrication | TEFCO';
const description = "Answers to common questions about TEFCO's custom iron, powder coating, sandblasting & fabrication in Ogden, Utah. Or just call us: (801) 621-1010.";

const groups = [
  {
    heading: 'General', sec: '' as const, items: [
      { q: 'What does TEFCO make?', a: 'We design and build custom ironwork — railings, gates, security doors, and staircases — plus powder coating, sandblasting, and general metal fabrication, all in our Ogden shop.' },
      { q: "What's your service area?", a: 'We serve Ogden, Weber County, and Northern Utah from Salt Lake City to the Idaho border, and take select projects farther south.' },
      { q: 'Are you family owned?', a: 'Yes — TEFCO has been family owned since 1942.' },
      { q: 'Do you offer free estimates?', a: 'Always — estimates are free and no-obligation.' },
      { q: 'Are you licensed and insured?', a: 'Yes, TEFCO is licensed and insured. <em>[[CONFIRM: license # / insurer to cite]]</em>' },
    ],
  },
  {
    heading: 'Railings & Stairs', sec: 'gray' as const, items: [
      { q: 'What railing styles can you build?', a: 'Ornamental, modern, rustic, or traditional — plus cable railing and floating stairs.' },
      { q: 'Do you install the railings too?', a: 'Yes — we measure on site, fabricate in our Ogden shop, and our own crew installs.' },
      { q: 'Is cable railing safe?', a: 'Yes — built to code, cable railing meets the same safety requirements as traditional railing.' },
      { q: 'Do floating stairs need a wall?', a: 'Not always — they can mount to a wall, a hidden central stringer, or a steel structure we build.' },
    ],
  },
  {
    heading: 'Gates & Security Doors', sec: '' as const, items: [
      { q: 'What types of gates do you build?', a: 'Entry, driveway (swing or slide), garden/walk, and security gates in iron, steel, or aluminum.' },
      { q: 'Can my gate be automated?', a: 'Yes — we build gates ready for automatic openers and access controls.' },
      { q: 'What makes a security door different?', a: 'A heavy steel/iron frame, reinforced corners, and a secure lock that resists forced entry — while a screen or grille still lets in air and light.' },
      { q: 'Can a security door match my home?', a: 'Yes — built to your opening and powder-coated in your choice of colors.' },
    ],
  },
  {
    heading: 'Powder Coating & Blasting', sec: 'gray' as const, items: [
      { q: 'How does powder coating work?', a: 'Dry pigment is electrostatically sprayed onto clean metal, then oven-cured into a hard, even shell — far more durable than paint.' },
      { q: 'How do I maintain powder-coated surfaces?', a: 'Wash with mild soap and water; avoid abrasives and harsh solvents.' },
      { q: 'What is sandblasting?', a: 'Blasting propels an abrasive at high pressure to strip rust, paint, and coatings, leaving clean bare metal ready for finishing.' },
      { q: 'Is blasting the best prep for coating?', a: 'For metal, yes — it gives the cleanest, best-bonding surface, which is why we blast before powder coating.' },
    ],
  },
  {
    heading: 'Fabrication & Planters', sec: '' as const, items: [
      { q: 'What can you build?', a: 'Edging, fire pits, ladders, radius containers, railings, roof racks, table frames, tool boxes, planters, and more.' },
      { q: 'What metals do you work with?', a: 'Aluminum, mild/carbon steel, stainless, wrought/cast iron, galvanized steel, copper and copper alloys, corten, and more.' },
      { q: 'What are your planters made from?', a: 'Aluminum, mild steel, or corten — any size, shape, and powder-coat color.' },
      { q: 'What planter accessories can I add?', a: 'Irrigation, LED lighting, casters, and integrated sound systems.' },
    ],
  },
];

const allItems = groups.flatMap((g) => g.items);
const schema = [faqPage(allItems), breadcrumb([{ name: 'Home', path: '/' }, { name: 'FAQs', path }])];
---
<BaseLayout title={title} description={description} path={path} active="/about-us/" solidHeader schema={schema}>
  <section class="features" style="padding-top:140px;padding-bottom:8px;">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Questions</span>
        <h2>Frequently asked questions</h2>
        <p>Answers about our custom iron, powder coating, sandblasting, and fabrication. Don't see yours? Call <a href="tel:8016211010">(801) 621-1010</a>.</p>
      </div>
    </div>
  </section>

  {groups.map((g) => <FAQ eyebrow={g.heading} heading={g.heading} sec={g.sec} items={g.items} />)}

  <CtaBand heading="Didn't see your question? Just ask." text="Call us or request a free estimate — we're happy to help." />
</BaseLayout>
