---
import { nav, business } from '../data/site';
interface Props { active?: string; solid?: boolean; heroLogo?: boolean; }
const { active = '', solid = false, heroLogo = false } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? active === '/' : active === href || active.startsWith(href);
---
<header class={`site-header${solid ? ' solid' : ''}`} data-hero-logo={heroLogo ? '' : undefined}>
  <div class="wrap header-inner">
    {heroLogo && (
      <img class="header-logo-slide" src="/images/tefco-logo-inverted.png" alt="TEFCO" aria-hidden="true" />
    )}
    <a href="/" class="logo">
      <img class="mark" src={business.logo} alt="TEFCO — custom iron & metal fabrication in Ogden, Utah" />
    </a>
    <nav class="desk-nav">
      {nav.map((n) => (
        <a href={n.href} class={isActive(n.href) ? 'active' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="quick-dial" href={business.phoneHref}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="num">{business.phone}</span>
      </a>
      <button class="btn-cta" data-open-quote>Get a Quote</button>
    </div>
    <div class="mobile-controls">
      <button id="burger" aria-label="Menu">
        <svg id="burgerOpen" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg id="burgerClose" style="display:none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="inner">
      <nav>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <button class="btn-cta" data-open-quote>Get a Quote</button>
    </div>
  </div>
</header>
