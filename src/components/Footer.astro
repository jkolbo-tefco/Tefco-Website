---
import { business, footerServices } from '../data/site';
const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Our Process', href: '/our-process/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Contact Us', href: '/contact-us/' },
];
const year = 2026;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-logo">
          <img src={business.logo} alt="TEFCO" />
        </a>
        <p class="footer-byline">Welcome to TEFCO. We've been crafting ornamental iron &amp; custom metal fabrication in Ogden since 1942. Family owned, licensed &amp; insured. Call or use our online form to speak with a team member — we'd love to build something for you.</p>
      </div>
      <div>
        <h4>Quick Links</h4>
        <ul>
          {quickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          {footerServices.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Contact Us</h4>
        <ul>
          <li class="contact-li">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={business.phoneHref} class="mono">{business.phone}</a>
          </li>
          <li class="contact-li">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </li>
          <li class="contact-li">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{business.street}<br />{business.city}, {business.state} {business.zip}</span>
          </li>
        </ul>
        <h4 style="margin-top:24px;">Hours</h4>
        <p class="hours-p">Monday – Friday<br />8:00 AM – 4:30 PM</p>
      </div>
    </div>
    <hr class="footer-bottom-hr" />
    <div class="footer-bottom">
      <span>copyright © {year} TEFCO | all rights reserved</span>
      <span><a href="/sitemap/">sitemap</a> | <a href="/privacy/">privacy policy</a></span>
    </div>
  </div>
</footer>
