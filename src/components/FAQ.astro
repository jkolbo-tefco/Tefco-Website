---
import type { FaqItem } from '../lib/schema';
interface Props {
  eyebrow?: string;
  heading?: string;
  sec?: '' | 'gray' | 'warm' | 'pale';
  items: FaqItem[];
}
const { eyebrow = 'Questions', heading = 'FAQs', sec = 'gray', items } = Astro.props;
const secClass = sec ? ` sec-${sec}` : '';
---
<section class={`faqs${secClass}`}>
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{heading}</h2>
    </div>
    <div class="faq-list">
      {items.map((it, i) => (
        <details open={i === 0}>
          <summary>{it.q}<span class="pm">+</span></summary>
          <div class="ans" set:html={it.a}></div>
        </details>
      ))}
    </div>
  </div>
</section>
