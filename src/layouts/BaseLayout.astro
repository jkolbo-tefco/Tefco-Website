---
import '../styles/tefco.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path for canonical + OG URL, e.g. "/railings/" */
  path?: string;
  ogImage?: string;
  active?: string;
  solidHeader?: boolean;
  /** One or more JSON-LD objects rendered into <head> */
  schema?: object | object[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = 'https://tefcofab.com/wp-content/uploads/2024/11/101810-003-scaled.jpg',
  active = path,
  solidHeader = false,
  schema,
} = Astro.props;

const canonical = new URL(path, Astro.site ?? 'https://tefcofab.com').href;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/webp" href="/images/tefco-logo.webp" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

  {schemaList.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header active={active} solid={solidHeader} />
  <main>
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/tefco.js';
  </script>
</body>
</html>
